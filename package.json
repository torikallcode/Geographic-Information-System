{
  "name": "gis-tata-ruang",
  "version": "1.0.0",
  "private": true,
  "description": "Portal peta tata ruang publik dan panel admin untuk pengelolaan data spasial",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @gis/api",
    "dev:web": "npm run dev -w @gis/web",
    "build": "npm run build -w @gis/web",
    "typecheck": "npm run typecheck -w @gis/api && npm run typecheck -w @gis/web",
    "test": "npm run test -w @gis/api",
    "seed": "npm run seed -w @gis/api",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:logs": "docker compose logs -f db",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "start": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
