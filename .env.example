# Database (Docker Compose memakai port 5433 agar tidak bentrok dengan PostgreSQL lokal)
DATABASE_URL=postgres://gis:gis_dev_password@localhost:5433/gis_tataruang

# API
PORT=4000
HOST=0.0.0.0
JWT_SECRET=ganti-dengan-rahasia-panjang-acak-minimal-32-karakter
JWT_EXPIRES_IN=8h
WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# Tampilkan token reset password di respons API (hanya untuk pengembangan lokal)
EXPOSE_RESET_TOKEN=true

# Pencarian alamat (OpenStreetMap Nominatim)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=GIS-Tata-Ruang-Local/1.0 (proyek pembelajaran)
